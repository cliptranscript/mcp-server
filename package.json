{
  "name": "clipscript-mcp",
  "version": "1.0.0",
  "description": "Video transcript MCP server by Clipscript: transcribe YouTube, TikTok, Instagram Reels, Facebook and X videos to text, with TXT, SRT, VTT and JSON subtitle export.",
  "type": "module",
  "bin": {
    "clipscript-mcp": "server/index.js"
  },
  "files": [
    "server",
    "icon.png",
    "manifest.json",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "bundle": "mcpb pack . clipscript.mcpb"
  },
  "dependencies": {
    "mcp-remote": "0.14.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Codex",
  "contributors": [
    {
      "name": "Codex"
    }
  ],
  "license": "MIT",
  "homepage": "https://cliptranscript.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cliptranscript/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/cliptranscript/mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "clipscript",
    "video-transcript",
    "transcribe-video",
    "video-to-text",
    "transcript-generator",
    "youtube-transcript",
    "tiktok-transcript",
    "reel-transcript",
    "subtitles"
  ],
  "mcpName": "io.github.cliptranscript/mcp-server",
  "overrides": {
    "tmp": "^0.2.6"
  }
}
