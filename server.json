{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cliptranscript/mcp-server",
  "description": "Clipscript MCP: transcripts of YouTube, TikTok, Instagram, Facebook and X videos from a link.",
  "repository": {
    "url": "https://github.com/cliptranscript/mcp-server",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "clipscript-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://cliptranscript.app/mcp"
    }
  ]
}
